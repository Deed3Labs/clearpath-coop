# The join form posts here. Until it is set, the form reports a failure and
# stores nothing — it never reports success without a 2xx from a real
# endpoint. See components/interactive/JoinForm.tsx.
#
# Any endpoint that accepts a JSON POST works. The body is the form's fields
# plus `as`, which is the mode: member | shop | land | work.
NEXT_PUBLIC_JOIN_ENDPOINT=
